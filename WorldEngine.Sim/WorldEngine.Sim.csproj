<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>12</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <OutputType>Exe</OutputType>
    <!-- XML doc generation for gen-map.py. CS1591 (missing summary) is suppressed on members;
         only the PRIMARY public type of each file is required to have a <summary> (enforced by
         scripts/doc-check.py, not the compiler). This avoids 3114 CS1591 errors from members/fields.
         DECISION: scoped enforcement via script rather than compiler because 3114 missing-member
         docs would require ~3 weeks of mechanical annotation with minimal value. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.79" />
    <PackageReference Include="MessagePack" Version="3.1.8" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.9" />
    <!-- Override the transitive SQLitePCLRaw that Microsoft.Data.Sqlite 10.0.9 pulls: its
         lib.e_sqlite3 2.1.11 carries a high-severity advisory (GHSA-2m69-gcr7-jv3q). 2.1.12 is
         the same-line security patch (the .NET 10 SDK's transitive NuGet audit flags 2.1.11). -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.12" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.9" />
    <PackageReference Include="System.IO.Hashing" Version="10.0.9" />
    <PackageReference Include="Tomlyn" Version="0.16.2" />
  </ItemGroup>

</Project>
